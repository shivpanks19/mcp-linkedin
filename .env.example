# LinkedIn OAuth Credentials
# Get these from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# OAuth callback URL (must match what's configured in LinkedIn Developer Portal)
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Optional: Token storage location (defaults to ~/.linkedin-ads-mcp/tokens.json)
# TOKEN_STORAGE_PATH=/custom/path/to/tokens.json

# --- Render / HTTP MCP (same pattern as mcp-google-ads) ---
# Build: npm install && npm run build
# Start:  npm run start:http
# Health: /health   MCP: /mcp   (PORT is set automatically by Render)
# See docs/render-deploy.md
#
# Paste ~/.linkedin-ads-mcp/tokens.json as ONE LINE (npm run print-tokens).
# LINKEDIN_TOKENS_JSON={"access_token":"...","refresh_token":"...","expires_in":5184000,"expires_at":1793357724,"scope":"rw_ads r_ads_reporting","refresh_token_expires_in":31536000}
#
# Secret required on /mcp. Cursor URL: https://YOUR-SERVICE.onrender.com/mcp?token=...
# MCP_URL_AUTH_TOKEN=generate_a_long_random_string
#
# Optional: comma-separated Host headers if you enable DNS rebinding checks
# MCP_ALLOWED_HOSTS=your-service.onrender.com,localhost
